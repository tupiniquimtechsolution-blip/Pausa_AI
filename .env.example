# Pausa AI - exemplo de ambiente sem segredos reais.

# Local: SQLite. Staging/producao: usar PostgreSQL gerenciado e banco separado.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pausa_ai?schema=public"

# Autenticacao e seguranca.
# Em staging/producao, trocar por valor longo, aleatorio e exclusivo do ambiente.
JWT_SECRET="change-this-secret"
RATE_LIMIT_PEPPER="change-this-rate-limit-pepper"
COOKIE_SECURE="false"
APP_BASE_URL="http://localhost:3000"
CRON_SECRET=""
AUDIT_LOG_RETENTION_DAYS="180"
RELEASE_VERSION="development"

# IA opcional. Vazio mantém fallback local por regras.
OPENAI_API_KEY=""

# Admin local.
ADMIN_EMAIL="admin@pausaai.com"

# Links publicos opcionais.
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/pausaai"
NEXT_PUBLIC_SPOTIFY_URL=""

# E-mail transacional. Nao preencher com segredo real no Git.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Pausa AI <onboarding@resend.dev>"

# B2B real fica desligado por padrao. Demo/mock continua como experiencia segura.
B2B_REAL_DASHBOARD_ENABLED="false"

# Mobile/WebView.
# Expo tenta resolver a URL via hostUri em dev. Em celular fisico, use IP LAN atual.
# Para APK/staging, configurar defaultWebBaseUrl no mobile/app.json antes do build.
# Exemplo local: http://192.168.0.10:3000
