  sensitiveDataVisible Boolean  @default(false)
  status               String   @default("DRAFT")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
}

model AudioProviderCapability {
  id                 String    @id @default(cuid())
  providerKey        String
  capability         String
  enabled            Boolean   @default(false)
  credentialsPresent Boolean   @default(false)
  testStatus         String    @default("NOT_TESTED")
  lastTestedAt       DateTime?
  configJson         String    @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([providerKey, capability])
  @@index([enabled, testStatus])
}

model B2BLead {
  id            String    @id @default(cuid())
  name          String
  email         String
  phone         String
  company       String
  role          String
  employeeCount Int
  interest      String
  message       String?
  status        String    @default("NOVO")
  notes         String?
  nextContactAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Partner {
  id              String            @id @default(cuid())
  name            String
  type            String
  benefitProvider String
  websiteUrl      String?
  instagramUrl    String?
  bookingUrl      String?
  status          String            @default("COMING_SOON")
  description     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  interests       PartnerInterest[]
}

model PartnerInterest {
  id           String   @id @default(cuid())
  userId       String
  partnerId    String
  interestType String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner      Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model Company {
  id            String              @id @default(cuid())
  name          String
  plan          String
  employeeLimit Int
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  metrics       CompanyMetricMock[]
  users         User[]
}

model CompanyMetricMock {
  id             String   @id @default(cuid())
  companyId      String
  date           DateTime
  avgMood        Float
  avgStress      Float
  avgSleep       Float
  avgEnergy      Float
  engagementRate Float
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}
