generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MediaLifecycleStatus {
  DRAFT
  TECHNICAL_REVIEW
  EDITORIAL_REVIEW
  HEALTH_REVIEW
  RIGHTS_REVIEW
  LOCALIZATION_REVIEW
  APPROVED
  PUBLISHED
  SUSPENDED
  ARCHIVED
  EXPIRED
  REJECTED
}

model User {
  id                          String                       @id @default(cuid())
  name                        String
  email                       String                       @unique
  passwordHash                String
  role                        String                       @default("USER")
  plan                        String                       @default("FREE")
  companyId                   String?
  department                  String?
  companyRole                 String?
  level                       Int                          @default(1)
  xp                          Int                          @default(0)
  lastLevelUpAt               DateTime?
  onboardingCompleted         Boolean                      @default(false)
  sessionVersion              Int                          @default(1)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  profile                     Profile?
  checkins                    Checkin[]
  missionCompletions          MissionCompletion[]
  workoutSessions             WorkoutSession[]
  exerciseProgresses          ExerciseProgress[]
  exerciseSessions            ExerciseSession[]
  exerciseInstructionSessions ExerciseInstructionSession[]
  partnerInterests            PartnerInterest[]
  passwordResetTokens         PasswordResetToken[]
  routineReminders            RoutineReminder[]
  routineTasks                RoutineTask[]
  socialDowntime              SocialDowntime?
  agendaEvents                AgendaEvent[]
  agendaTasks                 AgendaTask[]
  agendaReminders             AgendaReminder[]
  agendaHabits                AgendaHabit[]
  calendarConnections         CalendarConnection[]
  syncQueueItems              SyncQueue[]
  inboxItems                  InboxItem[]
  yogaPracticeSessions        YogaPracticeSession[]
  achievements                UserAchievement[]
  focusSessions               FocusSession[]
  weeklyPlans                 WeeklyPlan[]
  healthMetricSnapshots       HealthMetricSnapshot[]
  walkingSessions             WalkingSession[]
  walkingGoals                WalkingGoal[]
  walkingFavoriteRoutes       WalkingFavoriteRoute[]
  activityCompletions         ActivityCompletion[]
  userRoles                   UserRole[]                   @relation("UserRoleUser")
  roleAssignmentsMade         UserRole[]                   @relation("UserRoleAssignedBy")
  auditLogs                   AuditLog[]                   @relation("AuditActor")
  featureFlagAudits           FeatureFlagAudit[]           @relation("FeatureFlagAuditActor")
  platformPermissions         PlatformPermissionRecord[]
  scheduleReservations        ScheduleReservation[]
  scheduleMutexes             ScheduleMutex[]
  notificationPolicy          NotificationPolicy?
  recommendationDecisions     RecommendationDecision[]
  sessionFeedback             SessionFeedback[]
  notificationPlans           NotificationPlan[]
  pausaActivities             PausaActivity[]
  healthProfileEntries        HealthProfileEntry[]
  dataConsents                DataConsent[]
  connectedDevices            ConnectedDevice[]
  dataVaultEvents             DataVaultEvent[]
  activityRoutes              ActivityRoute[]
  shareCards                  ShareCard[]
  company                     Company?                     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String
  scope       String           @default("APPLICATION")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id           String    @id @default(cuid())
  userId       String
  roleId       String
  assignedById String?
  reason       String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?     @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@index([expiresAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  action        String
  targetType    String
  targetId      String?
  correlationId String
  environment   String   @default("local")
  metadataJson  String   @default("{}")
  beforeHash    String?
  afterHash     String?
  ipHash        String?
  userAgent     String?
  createdAt     DateTime @default(now())
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([correlationId])
  @@index([createdAt])
}

model FeatureFlag {
  key               String             @id
  description       String
  owner             String
  defaultValue      Boolean            @default(false)
  enabledLocal      Boolean            @default(false)
  enabledTest       Boolean            @default(false)
  enabledStaging    Boolean            @default(false)
  enabledProduction Boolean            @default(false)
  platformsJson     String             @default("[]")
  rolesJson         String             @default("[]")
  segmentsJson      String             @default("[]")
  reviewAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  audits            FeatureFlagAudit[]
}

model FeatureFlagAudit {
  id             String      @id @default(cuid())
  featureFlagKey String
  actorId        String?
  environment    String
  previousValue  Boolean
  nextValue      Boolean
  correlationId  String
  reason         String?
  createdAt      DateTime    @default(now())
  featureFlag    FeatureFlag @relation(fields: [featureFlagKey], references: [key], onDelete: Cascade)
  actor          User?       @relation("FeatureFlagAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([featureFlagKey, createdAt])
  @@index([actorId, createdAt])
}

model PlatformPermissionRecord {
  id            String   @id @default(cuid())
  userId        String
  permissionKey String
  platform      String
  status        String
  source        String   @default("CLIENT_REPORTED")
  detailsJson   String   @default("{}")
  lastCheckedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionKey, platform])
  @@index([userId, lastCheckedAt])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  dedupeKey     String    @unique
  eventType     String
  aggregateType String
  aggregateId   String
  payloadJson   String
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now())
  processedAt   DateTime?
  correlationId String
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
}

model RateLimitBucket {
  keyHash      String   @id
  scope        String
  count        Int      @default(0)
  windowEnd    DateTime
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([scope, windowEnd])
  @@index([lastSeenAt])
}

model ScheduleMutex {
  userId    String
  bucketKey String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, bucketKey])
}

model ScheduleReservation {
  id             String   @id @default(cuid())
  userId         String
  entityType     String
  entityId       String
  title          String
  startDateTime  DateTime
  endDateTime    DateTime
  timezone       String   @default("America/Sao_Paulo")
  recurrenceRule String?
  status         String   @default("ACTIVE")
  version        Int      @default(1)
  dedupeKey      String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId])
  @@index([userId, startDateTime, endDateTime])
  @@index([userId, status])
}

model NotificationPolicy {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  maxPerDay              Int      @default(4)
  minimumIntervalMinutes Int      @default(120)
  quietHoursStart        String   @default("22:00")
  quietHoursEnd          String   @default("07:00")
  ignoredReductionAfter  Int      @default(3)
  lockScreenPrivacy      String   @default("HIDE_SENSITIVE")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  mainGoal                    String
  dailyTime                   String
  preferredTime               String
  stressLevel                 String
  difficultyArea              String
  workHours                   Int      @default(8)
  freeHours                   Int      @default(2)
  sleepHours                  Int      @default(7)
  sleepAlarm                  String?
  wakeAlarm                   String?
  alarmsEnabled               Boolean  @default(false)
  sleepAlarmEnabled           Boolean  @default(false)
  wakeAlarmEnabled            Boolean  @default(false)
  nativeSleepAlarmId          String?
  nativeWakeAlarmId           String?
  trainingIntensityPreference String   @default("manter")
  movementPreferences         String?
  theme                       String   @default("system")
  language                    String   @default("pt-BR")
  lastPreferenceUpdate        DateTime @default(now())
  emailRecommendationsEnabled Boolean  @default(false)
  pushNotificationsEnabled    Boolean  @default(false)
  dailyRecommendationTime     String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Checkin {
  id                          String                       @id @default(cuid())
  userId                      String
  moodScore                   Int
  focusScore                  Int                          @default(3)
  stressScore                 Int
  energyScore                 Int
  sleepScore                  Int
  dispositionScore            Int                          @default(3)
  tirednessScore              Int                          @default(3)
  anxietyScore                Int                          @default(3)
  painScore                   Int                          @default(1)
  painRegion                  String?
  availableMinutes            Int                          @default(5)
  journalText                 String?
  riskDetected                Boolean                      @default(false)
  aiSummary                   String
  aiRecommendation            String
  dailyMissionTitle           String
  dailyMissionDescription     String
  dailyMissionSteps           String
  encouragement               String
  profileState                String?
  primaryArea                 String?
  secondaryArea               String?
  manualTags                  String?
  detectedTags                String?
  recommendationReason        String?
  recommendedInstructionSlug  String?
  recommendedExerciseId       String?
  alternativeExerciseId       String?
  createdAt                   DateTime                     @default(now())
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionCompletions          MissionCompletion[]
  recommendedExercise         Exercise?                    @relation("RecommendedExercise", fields: [recommendedExerciseId], references: [id], onDelete: SetNull)
  alternativeExercise         Exercise?                    @relation("AlternativeExercise", fields: [alternativeExerciseId], references: [id], onDelete: SetNull)
  exerciseSessions            ExerciseSession[]
  exerciseInstructionSessions ExerciseInstructionSession[]
  activityCompletions         ActivityCompletion[]
  recommendationDecision      RecommendationDecision?
}

model Mission {
  id                 String              @id @default(cuid())
  title              String              @unique
  category           String
  durationMinutes    Int
  description        String
  steps              String
  unlockLevel        Int                 @default(1)
  isPremium          Boolean             @default(false)
  complexity         String              @default("Simples")
  activityType       String              @default("Autocuidado")
  intensity          String              @default("Leve")
  safetyNote         String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  missionCompletions MissionCompletion[]
}

model MissionCompletion {
  id          String   @id @default(cuid())
  userId      String
  missionId   String?
  checkinId   String?
  xpAwarded   Int      @default(0)
  levelAfter  Int      @default(1)
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  checkin     Checkin? @relation(fields: [checkinId], references: [id], onDelete: SetNull)
}

model WorkoutRoutine {
  id              String           @id @default(cuid())
  title           String           @unique
  category        String
  modality        String
  minLevel        Int              @default(1)
  description     String
  intensity       String
  paceMin         Int?
  paceMax         Int?
  rounds          Int
  roundSeconds    Int
  restSeconds     Int
  warmupSteps     String
  cooldownSteps   String
  safetyNotes     String
  alternative     String?
  xpReward        Int              @default(15)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workoutSessions WorkoutSession[]
}

model WorkoutSession {
  id              String         @id @default(cuid())
  userId          String
  routineId       String
  roundsCompleted Int
  durationSeconds Int
  paceUsed        Int?
  xpAwarded       Int            @default(0)
  completedAt     DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine         WorkoutRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
}

model Exercise {
  id                  String            @id
  area                String
  level               Int
  title               String            @unique
  shortDescription    String
  durationMinutes     Int
  difficultyLabel     String
  objective           String
  steps               String
  contraindications   String
  recommendedWhen     String
  avoidWhen           String
  xpReward            Int               @default(15)
  imageKey            String
  animationPromptKey  String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  recommendedCheckins Checkin[]         @relation("RecommendedExercise")
  alternativeCheckins Checkin[]         @relation("AlternativeExercise")
  sessions            ExerciseSession[]
}

model ExerciseProgress {
  id               String   @id @default(cuid())
  userId           String
  area             String
  completedCount   Int      @default(0)
  currentAreaLevel Int      @default(1)
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, area])
}

model ExerciseSession {
  id          String    @id @default(cuid())
  userId      String
  exerciseId  String
  checkinId   String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  xpAwarded   Int       @default(0)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  checkin     Checkin?  @relation(fields: [checkinId], references: [id], onDelete: SetNull)
}

model ExerciseInstruction {
  id                 String                       @id @default(cuid())
  slug               String                       @unique
  title              String
  area               String
  category           String
  categoryGroup      String                       @default("PHYSICAL")
  level              Int
  unlockLevel        Int                          @default(1)
  instructionType    String
  shortDescription   String
  objective          String
  durationSeconds    Int?
  sets               Int?
  reps               String?
  restSeconds        Int?
  intensity          String
  equipment          String
  imageKey           String
  animationPromptKey String
  recommendedWhen    String
  avoidWhen          String
  contraindications  String
  howToSteps         String
  postureTips        String
  breathingTips      String
  commonMistakes     String
  safetyNotes        String
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  sessions           ExerciseInstructionSession[]
}

model ExerciseInstructionSession {
  id             String              @id @default(cuid())
  userId         String
  instructionId  String
  checkinId      String?
  startedAt      DateTime            @default(now())
  completedAt    DateTime?
  xpAwarded      Int                 @default(10)
  closingMessage String?
  nextSuggestion String?
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  instruction    ExerciseInstruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  checkin        Checkin?            @relation(fields: [checkinId], references: [id], onDelete: SetNull)
}

model InstructionalVideo {
  id                String   @id @default(cuid())
  slug              String   @unique
  targetType        String
  targetSlug        String
  title             String
  category          String
  durationSeconds   Int
  videoUrl          String
  thumbnailUrl      String
  tags              String
  intensity         String
  equipment         String
  position          String
  benefitPrimary    String
  narrationScript   String
  batchWave         Int
  formatPrimary     String   @default("9:16")
  formatSecondary   String   @default("1:1")
  status            String   @default("PLANNED")
  approvalChecklist String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([targetType, targetSlug])
  @@index([batchWave])
  @@index([status])
}

model CatalogVisualAsset {
  id                        String    @id @default(cuid())
  identityKey               String    @unique
  catalogSection            String
  catalogArea               String
  catalogIdOrSlug           String
  catalogTitle              String
  matchType                 String
  matchedReferenceMovement  String
  imageAction               String
  visualAssetMode           String
  pullFromReferenceMovement String
  reusedFromReferenceId     String?
  reusedFromReferenceIds    String    @default("[]")
  reusedFromMovementId      String?
  reusedFromMovementIds     String    @default("[]")
  reusedFromAssetPattern    String
  reusedFromAssetPatterns   String    @default("[]")
  canonicalPoseId           String?
  imageSourcePath           String?
  resolvedImagePaths        String    @default("[]")
  physicalFilesFound        String    @default("[]")
  physicalFilesMissing      String    @default("[]")
  requiredPhysicalFiles     String    @default("[]")
  requiresCompleteAssetSet  Boolean   @default(true)
  approvalRequirement       String    @default("NONE")
  approvalStatus            String    @default("APPROVED")
  dependencyMovementIds     String    @default("[]")
  releasePolicy             String    @default("COMPLETE")
  decisionDate              DateTime?
  approvalDate              DateTime?
  approvalNote              String?
  blockReasonCode           String?
  assetStatus               String    @default("PLANNED")
  videoStatus               String    @default("PLANNED")
  needsReview               Boolean   @default(false)
  notes                     String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([catalogArea])
  @@index([catalogSection, catalogIdOrSlug])
  @@index([assetStatus])
  @@index([visualAssetMode])
}

model CatalogReconciliation {
  id                          String   @id @default(cuid())
  identityKey                 String   @unique
  catalogArea                 String
  catalogIdOrSlug             String
  catalogTitle                String
  sourceCatalog               String
  reconciliationStatus        String
  imageStatus                 String
  archiveReason               String?
  mappingCount                Int      @default(0)
  matchedReferenceMovementIds String   @default("[]")
  resolvedImagePaths          String   @default("[]")
  candidateImagePaths         String   @default("[]")
  blockReasonCode             String?
  needsReview                 Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([catalogArea, catalogIdOrSlug])
  @@index([reconciliationStatus])
  @@index([sourceCatalog])
}

model ActivityCompletion {
  id               String   @id @default(cuid())
  dedupeKey        String   @unique
  userId           String
  activityType     String
  source           String
  targetId         String
  checkinId        String?
  completionToken  String
  domainRecordType String
  domainRecordId   String?
  xpAwarded        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkin          Checkin? @relation(fields: [checkinId], references: [id], onDelete: SetNull)

  @@index([userId, activityType, targetId])
  @@index([checkinId])
  @@index([completionToken])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RoutineReminder {
  id                   String    @id @default(cuid())
  userId               String
  title                String
  description          String?
  category             String
  time                 String
  enabled              Boolean   @default(true)
  days                 String    @default("1,2,3,4,5,6,0")
  note                 String?
  reminderType         String    @default("PAUSE")
  scheduledAt          DateTime?
  repeatRule           String    @default("DAILY")
  snoozeEnabled        Boolean   @default(false)
  snoozeMinutesOptions String    @default("[5,10,15]")
  lastSnoozedAt        DateTime?
  status               String    @default("ACTIVE")
  nativeNotificationId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RoutineTask {
  id              String    @id @default(cuid())
  userId          String
  title           String
  description     String?
  category        String    @default("ROTINA")
  notes           String?
  dueDate         DateTime?
  dueTime         String?
  dueAt           DateTime?
  calendarEventId String?
  notificationId  String?
  status          String    @default("PENDING")
  priority        String    @default("MEDIUM")
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SocialDowntime {
  id             String   @id @default(cuid())
  userId         String   @unique
  enabled        Boolean  @default(false)
  startTime      String   @default("21:30")
  endTime        String   @default("07:00")
  apps           String   @default("Instagram,TikTok,YouTube,X")
  days           String   @default("1,2,3,4,5,6,0")
  note           String?
  objective      String   @default("PROTECT_FOCUS")
  categoriesJson String   @default("[]")
  exceptionsJson String   @default("[]")
  platformState  String   @default("MANUAL_CONFIGURATION")
  lastReportJson String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgendaEvent {
  id                 String           @id @default(cuid())
  userId             String
  title              String
  description        String?
  startDateTime      DateTime
  endDateTime        DateTime
  allDay             Boolean          @default(false)
  timezone           String           @default("America/Sao_Paulo")
  category           String           @default("ROTINA")
  priority           String           @default("MEDIUM")
  energyLevel        String           @default("MODERATE")
  source             String           @default("LOCAL")
  externalCalendarId String?
  externalEventId    String?
  recurrenceRule     String?
  reminderMinutes    String           @default("[30]")
  status             String           @default("CONFIRMED")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledTasks     AgendaTask[]     @relation("AgendaTaskScheduledEvent")
  linkedReminders    AgendaReminder[] @relation("AgendaReminderEvent")

  @@index([userId, startDateTime])
  @@index([userId, status])
  @@index([externalCalendarId, externalEventId])
}

model AgendaTask {
  id                String           @id @default(cuid())
  userId            String
  title             String
  description       String?
  dueDate           DateTime?
  estimatedDuration Int?
  category          String           @default("TAREFA")
  priority          String           @default("MEDIUM")
  energyLevel       String           @default("MODERATE")
  status            String           @default("PENDING")
  scheduledEventId  String?
  reminders         String           @default("[]")
  tags              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledEvent    AgendaEvent?     @relation("AgendaTaskScheduledEvent", fields: [scheduledEventId], references: [id], onDelete: SetNull)
  linkedReminders   AgendaReminder[] @relation("AgendaReminderTask")

  @@index([userId, status])
  @@index([userId, dueDate])
}

model AgendaReminder {
  id              String       @id @default(cuid())
  userId          String
  title           String
  message         String?
  dateTime        DateTime
  recurrenceRule  String?
  priority        String       @default("MEDIUM")
  notificationId  String?
  linkedEventId   String?
  linkedTaskId    String?
  status          String       @default("ACTIVE")
