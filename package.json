  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.5.1",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^16.2.6",
    "openai": "^4.72.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^2.13.3",
    "resend": "^6.12.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.6",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
