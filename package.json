    "test:w2:gate": "node scripts/run-w2-gate.mjs",
    "test:buttons": "tsx scripts/button-audit.ts",
    "test:w3": "tsx scripts/navigation-checks.ts",
    "test:w3:auth": "tsx scripts/w3-authenticated-checks.ts",
    "test:w3:gate": "node scripts/run-w3-gate.mjs",
    "test:w4": "tsx scripts/w4-content-library-checks.ts",
    "test:w5": "tsx scripts/w5-recommendation-checks.ts",
    "test:w6": "tsx scripts/w6-activity-checks.ts",
    "test:w7": "tsx scripts/w7-media-governance-checks.ts",
