    "db:seed": "tsx prisma/seed.ts",
    "db:seed:foundations": "tsx scripts/seed-foundations.ts",
    "assets:instructional": "tsx scripts/generate-instructional-assets.ts",
    "assets:movement-premium": "tsx scripts/generate-movement-premium-assets.ts --force",
    "assets:premium-apply": "tsx scripts/apply-premium-asset-families.ts --force",
    "assets:human-photos": "tsx scripts/apply-human-photo-assets.ts",
